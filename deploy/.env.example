INSTALLATION_ENV=docker
RAILS_ENV=production
NODE_ENV=production
RAILS_LOG_TO_STDOUT=true
DEFAULT_LOCALE=pt_BR
FRONTEND_URL=https://chatwoot.srv1779041.hstgr.cloud
SECRET_KEY_BASE=CHANGE_ME
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=chatwoot
POSTGRES_USERNAME=chatwoot
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
REDIS_URL=redis://:CHANGE_ME@redis:6379
ENABLE_ACCOUNT_SIGNUP=false

## Welucci Hub SSO
## The Hub (weHub) is the identity provider for every Welucci app. Chatwoot answers
## /sso?token= and redeems the token against WELUCCI_HUB_API_URL server-to-server.
## Leave any of the three required values blank and SSO stays off, with Chatwoot behaving
## exactly as it did before.
WELUCCI_HUB_API_URL=https://hub.welucci.com
# Public URL the browser is sent to. Defaults to WELUCCI_HUB_API_URL.
# WELUCCI_HUB_PUBLIC_URL=https://hub.welucci.com
# Must match INTERNAL_API_SECRET in the Hub.
WELUCCI_HUB_INTERNAL_SECRET=CHANGE_ME
# Chatwoot account that SSO arrivals are provisioned into, as an agent.
WELUCCI_HUB_ACCOUNT_ID=1
# Must match the platform id in the Hub's PLATFORM_REGISTRY.
# WELUCCI_HUB_PLATFORM_ID=chatwoot
# WELUCCI_HUB_EMAIL_DOMAIN=welucci.com
## Closes password login and password reset for @welucci.com, making the Hub the only door.
## Turn this on only after SSO is confirmed working in production — setting it back to
## false and restarting is the rollback.
WELUCCI_HUB_ENFORCE_SSO=false
